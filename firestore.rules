rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for Role Based Access Control (RBAC)
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function hasRole(role) {
      return isAuthenticated() && request.auth.token.role == role;
    }

    function isAdmin() {
      return hasRole('admin') || hasRole('super_admin');
    }

    function isAuditor() {
      return hasRole('auditor') || isAdmin();
    }

    // User Profile Security
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId) || isAdmin();
    }

    // Ledger & Transactions Security Rules (Fraud & Encryption Protected)
    match /transactions/{transactionId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() 
        && request.resource.data.amount is number 
        && request.resource.data.amount < 100000; // Flag high-value wires for CFO approval
      allow update, delete: if isAdmin();
    }

    // Audit Logs (Immutable, Write-Once or Admin Read)
    match /audit_logs/{logId} {
      allow read: if isAuditor();
      allow create: if isAuthenticated();
      allow update, delete: if false; // Immutable audit logs
    }

    // Security & Encryption Vault Keys
    match /vault_keys/{keyId} {
      allow read, write: if isAdmin();
    }
  }
}
